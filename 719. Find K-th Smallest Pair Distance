class Solution:
    def smallestDistancePair(self, nums: List[int], k: int) -> int:
        def countPair(nums,k,mid):
            count=0
            left=0
            for right in range(0,len(nums)):
                while nums[right] - nums[left] > mid:
                    left += 1
                count += right - left
            return count>=k
        nums.sort()
        left=0
        right=nums[-1]-nums[0]
        while left <right:
            mid=(left+right)//2

            if countPair(nums,k,mid):
                right=mid
            else:
                left=mid+1
        return left
        
